# TastyTrade credentials (optional - can also login via UI)
# TASTYTRADE_USERNAME=your@email.com
# TASTYTRADE_PASSWORD=yourpassword

# If you want to pre-load credentials server-side instead of login form:
# NEXT_PUBLIC_TT_USERNAME=your@email.com

# Observation-only evaluation for supported single-leg long debit options.
# This does not enable debit stop order creation, replacement, cancellation, or submission.
# NEXT_PUBLIC_DEBIT_STOP_OBSERVE_ENABLED=true

# TastyTrade credentials (optional - can also login via UI)
# TASTYTRADE_USERNAME=your@email.com
# TASTYTRADE_PASSWORD=yourpassword

# If you want to pre-load credentials server-side instead of login form:
# NEXT_PUBLIC_TT_USERNAME=your@email.com

# Observation-only evaluation for supported single-leg long debit options.
# This does not enable debit stop order creation, replacement, cancellation, or submission.
# NEXT_PUBLIC_DEBIT_STOP_OBSERVE_ENABLED=true

# OpenAI (server-only). Used by /api/analyze, /api/ocr, /api/advisor, /api/leaps-advisor.
# Never expose this with a NEXT_PUBLIC_ prefix.
# OPENAI_API_KEY=sk-your-key-here

# AI policy gateway (lib/ai-policy, AI-POLICY-0001A). All server-only; none may use a NEXT_PUBLIC_ prefix.
# Everything defaults OFF / unavailable: any missing or invalid value makes a route unavailable (fail closed).
# AI_POLICY_ENABLED=true                       # global flag; a route also needs its own flag below
# AI_POLICY_SCAN_SUMMARY_ENABLED=true
# AI_POLICY_GROUNDED_CHAT_ENABLED=true
# AI_POLICY_LEAPS_DEEP_ENABLED=true
# AI_POLICY_PMCC_DEEP_ENABLED=true
# AI_POLICY_RETRO_BATCH_ENABLED=true           # deferred route; not dispatched by the gateway yet
# AI_POLICY_ECONOMY_MODEL=<model name>         # tier -> model; the model must be allowlisted AND priced in lib/ai-policy/pricing.ts
# AI_POLICY_REASONING_MODEL=<model name>
# AI_POLICY_ALLOWED_MODELS=<model>,<model>     # comma-separated allowlist
# AI_POLICY_PROVIDER_GOVERNANCE_ATTESTED=true  # only after confirming OpenAI data controls for this account
# AI_POLICY_PROVIDER_POLICY_VERSION=<string>   # recorded in every audit record
# AI_POLICY_ARTIFACT_KEY=<64 hex chars>        # AES-256-GCM key for stored inputs/artifacts (openssl rand -hex 32)
# AI_POLICY_ARTIFACT_KEY_PREVIOUS=<64 hex>     # optional: previous key, kept while rotating
# AI_POLICY_SCOPE_SECRET=<16+ chars>           # HMAC secret for opaque account-scope ids
# AI_POLICY_USER_MONTHLY_BUDGET_USD=<decimal>  # per-user monthly allowance (unset -> route unavailable)
# AI_POLICY_GLOBAL_DAILY_BUDGET_USD=<decimal>  # all users, per UTC day (unset -> route unavailable)
# AI_POLICY_SCAN_SUMMARY_HOURLY_LIMIT=<int>    # per user, per route, per hour; one per route:
#   AI_POLICY_GROUNDED_CHAT_HOURLY_LIMIT, AI_POLICY_LEAPS_DEEP_HOURLY_LIMIT, AI_POLICY_PMCC_DEEP_HOURLY_LIMIT, AI_POLICY_RETRO_BATCH_HOURLY_LIMIT
# Launch gate (AI-POLICY-0001F): in Production a route also needs an approved, unexpired gate in lib/ai-policy/launchGates.ts.
# Preview and local dev can skip the gate with the line below. It is IGNORED when VERCEL_ENV=production.
# AI_POLICY_ALLOW_UNGATED_PREVIEW=true
# Test-only provider stub. Ignored (inert) when VERCEL_ENV=production or NODE_ENV=production without VERCEL_ENV:
# AI_POLICY_PROVIDER_STUB=true
# Runtime kill switches live in Redis, not env: SET ai-policy:kill:global 1  /  ai-policy:kill:route:<route> 1  (DEL or 0/false/off to lift).

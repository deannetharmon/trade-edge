+// lib/portfolio/closeOrderSubmission.ts
+//
+// ES-0001 (Product Owner corrective round), REQUIRED CORRECTION #10: the
+// Product Owner asked for broker-boundary integration tests proving a safety
+// failure can never reach a live broker submission function. Before this
+// module existed, that guarantee lived only as inline logic duplicated at
+// each submission call site in `app/portfolio/page.tsx` (BatchConfirmModal's
+// `submitAll` and `SetStopLossButton`'s `submit`) -- true by inspection, but
+// not provable by an automated test, because the broker functions
+// (`ttPost`/`ttPostComplex`) are unexported local functions inside a
+// 10,500-line client component with no seam for a broker mock.
+//
+// This module is the MINIMUM extraction necessary to create that seam. It
+// does not replicate order-body construction, GTC/OCO cancellation, roll
+// input validation, or any React/UI state -- all of that remains exactly
+// where it was in page.tsx. This module owns exactly one decision: given a
+// position's structure-ambiguity flag and a safety-gate input, is the caller
+// allowed to invoke the broker submission function at all? Both real call
+// sites in page.tsx now delegate this decision here instead of duplicating
+// it, so the exact logic under test is the exact logic that runs in
+// production.
+
+import {
+  runCloseOrderSafetyGate,
+  type CanonicalCloseIdentity,
+  type SafetyCheckResult,
+  type SafetyGateInput,
+} from './closeOrderSafety';
+
+/** The structure-ambiguity fields already carried on `Position` in
+ *  app/portfolio/page.tsx -- passed here rather than importing the `Position`
+ *  type itself, to keep this module free of any page.tsx/React dependency. */
+export interface AmbiguityGuardInput {
+  identity: CanonicalCloseIdentity | null;
+  structureAmbiguous: boolean;
+  structureBlockMessage: string | null;
+}
+
+export interface GuardBlocked {
+  allowed: false;
+  reason: string;
+  safetyCheck: SafetyCheckResult | null;
+}
+
+export interface GuardAllowed {
+  allowed: true;
+  safetyCheck: SafetyCheckResult;
+}
+
+export type GuardResult = GuardBlocked | GuardAllowed;
+
+/**
+ * Step 1: the structure-level guard. Must pass before a `SafetyGateInput` can
+ * even be constructed -- an ambiguous or null identity has no canonical
+ * quantity or economics to check against. Returns `null` when the structure
+ * is fine to proceed past (i.e. NOT blocked at this step).
+ */
+export function guardAgainstAmbiguousStructure(input: AmbiguityGuardInput): GuardBlocked | null {
+  if (!input.identity || input.structureAmbiguous) {
+    return {
+      allowed: false,
+      reason: `AMBIGUOUS_POSITION_STRUCTURE -- ${input.structureBlockMessage ?? 'position structure could not be resolved unambiguously.'}`,
+      safetyCheck: null,
+    };
+  }
+  return null;
+}
+
+/** Step 2: the full economic/quote/payload safety gate. */
+export function guardWithSafetyGate(gateInput: SafetyGateInput): GuardResult {
+  const safetyCheck = runCloseOrderSafetyGate(gateInput);
+  if (!safetyCheck.ok) {
+    const reason = safetyCheck.issues.map(i => i.message).join(' ');
+    return { allowed: false, reason, safetyCheck };
+  }
+  return { allowed: true, safetyCheck };
+}
+
+export type SubmitCloseOrderResult<T> =
+  | { submitted: true; result: T; safetyCheck: SafetyCheckResult }
+  | { submitted: false; reason: string; safetyCheck: SafetyCheckResult | null };
+
+/**
+ * The single boundary every live close/roll/stop-loss submission passes
+ * through. `submitToBroker` is invoked if and ONLY IF both guards pass --
+ * this is the exact property broker-boundary tests assert with a mock in
+ * place of the real `ttPost`/`ttPostComplex` functions. Never call a broker
+ * function directly at a call site that has this guard available; route
+ * through here so a safety failure structurally cannot reach it.
+ */
+export async function submitCloseOrderIfSafe<T>(
+  structureGuardInput: AmbiguityGuardInput,
+  gateInput: SafetyGateInput,
+  submitToBroker: (safetyCheck: SafetyCheckResult) => Promise<T>
+): Promise<SubmitCloseOrderResult<T>> {
+  const structureBlock = guardAgainstAmbiguousStructure(structureGuardInput);
+  if (structureBlock) {
+    return { submitted: false, reason: structureBlock.reason, safetyCheck: structureBlock.safetyCheck };
+  }
+
+  const gateResult = guardWithSafetyGate(gateInput);
+  if (!gateResult.allowed) {
+    return { submitted: false, reason: gateResult.reason, safetyCheck: gateResult.safetyCheck };
+  }
+
+  const result = await submitToBroker(gateResult.safetyCheck);
+  return { submitted: true, result, safetyCheck: gateResult.safetyCheck };
+}

@@ -0,0 +1,553 @@
+// lib/portfolio/__tests__/closeOrderSubmission.test.ts
+//
+// ES-0001 (Product Owner corrective round), REQUIRED CORRECTION #10:
+// broker-boundary integration tests. These tests exercise the extracted
+// orchestration boundary in `closeOrderSubmission.ts` -- the exact code both
+// real submission call sites in app/portfolio/page.tsx (BatchConfirmModal's
+// `submitAll`, SetStopLossButton's `submit`) delegate to -- with a mock
+// broker function standing in for `ttPost`/`ttPostComplex`. The goal is to
+// PROVE, not just assert by inspection, that a safety failure can never
+// reach a live order submission function.
+//
+// Fixture note: all option symbols/strikes below are synthetic and do not
+// reproduce any real account's positions or transaction data.
+
+import { describe, expect, it, vi } from 'vitest';
+import {
+  analyzePositionStructure,
+  buildCanonicalCloseIdentity,
+  structureAnalysisToBlockingIssue,
+  type RawEconomicLeg,
+  type CanonicalCloseIdentity,
+  type OrderLegPayload,
+} from '../closeOrderSafety';
+import {
+  guardAgainstAmbiguousStructure,
+  submitCloseOrderIfSafe,
+  type AmbiguityGuardInput,
+} from '../closeOrderSubmission';
+import type { SafetyGateInput } from '../closeOrderSafety';
+
+function leg(overrides: Partial<RawEconomicLeg>): RawEconomicLeg {
+  return {
+    symbol: 'AAPL240816P00200000',
+    optionType: 'P',
+    strikePrice: 200,
+    direction: 'Short',
+    quantity: 1,
+    avgOpenPrice: 1.0,
+    ...overrides,
+  };
+}
+
+/** A resolvable 2-contract bull put spread: short $200 / long $195, $1.20 net credit. */
+function buildValidCreditIdentity(quantity = 2): CanonicalCloseIdentity {
+  const legs = [
+    leg({ symbol: 'S', strikePrice: 200, direction: 'Short', quantity, avgOpenPrice: 2.10 }),
+    leg({ symbol: 'L', strikePrice: 195, direction: 'Long', quantity, avgOpenPrice: 0.90 }),
+  ];
+  const analysis = analyzePositionStructure(legs);
+  if (analysis.status !== 'RESOLVED') throw new Error('fixture setup failed: expected RESOLVED');
+  const idResult = buildCanonicalCloseIdentity(analysis.structures[0], 'AAPL::2024-08-16', 'AAPL', '2024-08-16');
+  if (!idResult.ok) throw new Error('fixture setup failed: ' + idResult.message);
+  return idResult.identity;
+}
+
+/** A resolvable 3-contract bear call spread opened for a DEBIT (long leg
+ *  costs more than short leg collects) -- net debit $0.50/share. */
+function buildValidDebitIdentity(quantity = 3): CanonicalCloseIdentity {
+  const legs = [
+    leg({ symbol: 'CS', optionType: 'C', strikePrice: 560, direction: 'Short', quantity, avgOpenPrice: 1.00 }),
+    leg({ symbol: 'CL', optionType: 'C', strikePrice: 555, direction: 'Long', quantity, avgOpenPrice: 1.50 }),
+  ];
+  const analysis = analyzePositionStructure(legs);
+  if (analysis.status !== 'RESOLVED') throw new Error('fixture setup failed: expected RESOLVED');
+  const idResult = buildCanonicalCloseIdentity(analysis.structures[0], 'AAPL::2024-09-20', 'AAPL', '2024-09-20');
+  if (!idResult.ok) throw new Error('fixture setup failed: ' + idResult.message);
+  return idResult.identity;
+}
+
+/** The confirmed danger case: two independent same-quantity bull put spreads
+ *  in one symbol+expiration bucket -- 2 shorts + 2 longs, all qty=2. */
+function buildAmbiguousLegs(): RawEconomicLeg[] {
+  return [
+    leg({ symbol: 'S1', strikePrice: 200, direction: 'Short', quantity: 2 }),
+    leg({ symbol: 'L1', strikePrice: 195, direction: 'Long', quantity: 2 }),
+    leg({ symbol: 'S2', strikePrice: 190, direction: 'Short', quantity: 2 }),
+    leg({ symbol: 'L2', strikePrice: 185, direction: 'Long', quantity: 2 }),
+  ];
+}
+
+function legsToActualOrderLegs(identity: CanonicalCloseIdentity, requestedQuantity: number): OrderLegPayload[] {
+  return identity.legs.map(l => ({ symbol: l.symbol, quantity: requestedQuantity, direction: l.direction }));
+}
+
+// ---------------------------------------------------------------------------
+// 1. Ambiguous structure: broker mock is NEVER called
+// ---------------------------------------------------------------------------
+
+describe('submitCloseOrderIfSafe -- ambiguous / unresolved structure', () => {
+  it('does not call the broker when two independent same-quantity spreads are ambiguous (same symbol/expiration/quantity, different strikes)', async () => {
+    const analysis = analyzePositionStructure(buildAmbiguousLegs());
+    expect(analysis.status).toBe('AMBIGUOUS');
+    const blockIssue = structureAnalysisToBlockingIssue(analysis);
+    expect(blockIssue?.ruleId).toBe('AMBIGUOUS_POSITION_STRUCTURE');
+
+    const brokerMock = vi.fn().mockResolvedValue({ data: { order: { id: 'SHOULD-NEVER-BE-SUBMITTED' } } });
+
+    const structureGuardInput: AmbiguityGuardInput = {
+      identity: null, // no identity can be built -- structure never resolved
+      structureAmbiguous: true,
+      structureBlockMessage: blockIssue?.message ?? null,
+    };
+    // Deliberately pass a well-formed gateInput to prove the STRUCTURE guard
+    // alone is sufficient to block -- it must never even reach the economic
+    // gate or the broker call.
+    const validIdentity = buildValidCreditIdentity();
+    const gateInput: SafetyGateInput = {
+      identity: validIdentity,
+      requestedQuantity: validIdentity.quantity,
+      closeableQuantity: validIdentity.quantity,
+      closePricePerUnit: 1.20,
+      requestedClosePriceEffect: 'Debit',
+      quote: { netBid: 1.15, netAsk: 1.25, netMid: 1.20, fetchedAtMs: Date.now() },
+    };
+
+    const result = await submitCloseOrderIfSafe(structureGuardInput, gateInput, brokerMock);
+
+    expect(result.submitted).toBe(false);
+    expect(brokerMock).not.toHaveBeenCalled();
+    if (!result.submitted) {
+      expect(result.reason).toContain('AMBIGUOUS_POSITION_STRUCTURE');
+    }
+  });
+
+  it('does not call the broker when identity is null (structure could not be resolved at all)', async () => {
+    const brokerMock = vi.fn();
+    const structureGuardInput: AmbiguityGuardInput = {
+      identity: null,
+      structureAmbiguous: false, // even if this flag were somehow false, null identity alone must block
+      structureBlockMessage: null,
+    };
+    const validIdentity = buildValidCreditIdentity();
+    const gateInput: SafetyGateInput = {
+      identity: validIdentity,
+      requestedQuantity: validIdentity.quantity,
+      closeableQuantity: validIdentity.quantity,
+      closePricePerUnit: 1.20,
+      requestedClosePriceEffect: 'Debit',
+    };
+    const result = await submitCloseOrderIfSafe(structureGuardInput, gateInput, brokerMock);
+    expect(result.submitted).toBe(false);
+    expect(brokerMock).not.toHaveBeenCalled();
+  });
+
+  it('guardAgainstAmbiguousStructure blocks before any identity/plan/gate call is made for the ambiguous fixture', () => {
+    // This directly proves the ordering the Product Owner required: the
+    // ambiguity check happens BEFORE buildCanonicalCloseIdentity would even
+    // be attempted -- there is no structure to build one from.
+    const analysis = analyzePositionStructure(buildAmbiguousLegs());
+    expect(analysis.status).toBe('AMBIGUOUS');
+    const guard = guardAgainstAmbiguousStructure({ identity: null, structureAmbiguous: true, structureBlockMessage: 'blocked' });
+    expect(guard).not.toBeNull();
+    expect(guard?.allowed).toBe(false);
+    expect(guard?.safetyCheck).toBeNull();
+  });
+});
+
+// ---------------------------------------------------------------------------
+// 2. Payload / display cross-check mismatches: broker mock is NEVER called
+// ---------------------------------------------------------------------------
+
+describe('submitCloseOrderIfSafe -- payload and display cross-checks', () => {
+  it('does not call the broker when the actual order-leg payload symbols differ from the plan (modal/broker payload divergence)', async () => {
+    const identity = buildValidCreditIdentity();
+    const brokerMock = vi.fn();
+    const wrongLegs: OrderLegPayload[] = [{ symbol: 'WRONG-SYMBOL', quantity: identity.quantity, direction: 'Short' }];
+
+    const result = await submitCloseOrderIfSafe(
+      { identity, structureAmbiguous: false, structureBlockMessage: null },
+      {
+        identity,
+        requestedQuantity: identity.quantity,
+        closeableQuantity: identity.quantity,
+        closePricePerUnit: 1.20,
+        requestedClosePriceEffect: 'Debit',
+        actualOrderLegs: wrongLegs,
+      },
+      brokerMock
+    );
+
+    expect(result.submitted).toBe(false);
+    expect(brokerMock).not.toHaveBeenCalled();
+    if (!result.submitted) {
+      expect(result.safetyCheck?.issues.map(i => i.ruleId)).toContain('LEG_IDENTITY_MISMATCH');
+    }
+  });
+
+  it('does not call the broker when the displayed expected P/L does not match the plan\'s computed P/L', async () => {
+    const identity = buildValidCreditIdentity();
+    const brokerMock = vi.fn();
+    const actualLegs = legsToActualOrderLegs(identity, identity.quantity);
+
+    const result = await submitCloseOrderIfSafe(
+      { identity, structureAmbiguous: false, structureBlockMessage: null },
+      {
+        identity,
+        requestedQuantity: identity.quantity,
+        closeableQuantity: identity.quantity,
+        closePricePerUnit: 1.20,
+        requestedClosePriceEffect: 'Debit',
+        actualOrderLegs: actualLegs,
+        displayedExpectedPnl: 999999, // wildly wrong vs. the plan's real computed P/L
+      },
+      brokerMock
+    );
+
+    expect(result.submitted).toBe(false);
+    expect(brokerMock).not.toHaveBeenCalled();
+    if (!result.submitted) {
+      expect(result.safetyCheck?.issues.map(i => i.ruleId)).toContain('DISPLAY_PAYLOAD_ECONOMICS_MISMATCH');
+    }
+  });
+
+  it('does not call the broker when a broker-payload leg quantity does not scale 1:1 with the requested quantity', async () => {
+    const identity = buildValidCreditIdentity(5); // 5-contract position
+    const brokerMock = vi.fn();
+    const mismatchedLegs: OrderLegPayload[] = identity.legs.map(l => ({ symbol: l.symbol, quantity: 3, direction: l.direction })); // wrong: should be 5
+
+    const result = await submitCloseOrderIfSafe(
+      { identity, structureAmbiguous: false, structureBlockMessage: null },
+      {
+        identity,
+        requestedQuantity: 5,
+        closeableQuantity: 5,
+        closePricePerUnit: 1.20,
+        requestedClosePriceEffect: 'Debit',
+        actualOrderLegs: mismatchedLegs,
+      },
+      brokerMock
+    );
+
+    expect(result.submitted).toBe(false);
+    expect(brokerMock).not.toHaveBeenCalled();
+    if (!result.submitted) {
+      const ruleIds = result.safetyCheck?.issues.map(i => i.ruleId) ?? [];
+      expect(ruleIds.some(r => r === 'PAYLOAD_QUANTITY_MISMATCH' || r === 'LEG_RATIO_MISMATCH')).toBe(true);
+    }
+  });
+});
+
+// ---------------------------------------------------------------------------
+// 3. Quantity boundaries: over-close blocked, partial close scales correctly
+// ---------------------------------------------------------------------------
+
+describe('submitCloseOrderIfSafe -- quantity boundaries', () => {
+  it('does not call the broker for an over-close request (requested > closeable)', async () => {
+    const identity = buildValidCreditIdentity(2);
+    const brokerMock = vi.fn();
+
+    const result = await submitCloseOrderIfSafe(
+      { identity, structureAmbiguous: false, structureBlockMessage: null },
+      {
+        identity,
+        requestedQuantity: 5, // more than the 2 held
+        closeableQuantity: 2,
+        closePricePerUnit: 1.20,
+        requestedClosePriceEffect: 'Debit',
+      },
+      brokerMock
+    );
+
+    expect(result.submitted).toBe(false);
+    expect(brokerMock).not.toHaveBeenCalled();
+    if (!result.submitted) {
+      expect(result.safetyCheck?.issues.map(i => i.ruleId)).toContain('REQUESTED_QTY_EXCEEDS_POSITION');
+    }
+  });
+
+  it('does not call the broker for a zero or negative requested quantity', async () => {
+    const identity = buildValidCreditIdentity(2);
+    for (const bad of [0, -1, 1.5]) {
+      const brokerMock = vi.fn();
+      const result = await submitCloseOrderIfSafe(
+        { identity, structureAmbiguous: false, structureBlockMessage: null },
+        {
+          identity,
+          requestedQuantity: bad,
+          closeableQuantity: 2,
+          closePricePerUnit: 1.20,
+          requestedClosePriceEffect: 'Debit',
+        },
+        brokerMock
+      );
+      expect(result.submitted).toBe(false);
+      expect(brokerMock).not.toHaveBeenCalled();
+    }
+  });
+
+  it('submits exactly ONE canonical spread unit for a 1-contract partial close from a 5-contract position, with the broker receiving the exact scaled plan', async () => {
+    const identity = buildValidCreditIdentity(5);
+    const brokerMock = vi.fn().mockResolvedValue({ data: { order: { id: 'OK-1' } } });
+    const requestedQuantity = 1;
+    const actualLegs = legsToActualOrderLegs(identity, requestedQuantity);
+
+    const result = await submitCloseOrderIfSafe(
+      { identity, structureAmbiguous: false, structureBlockMessage: null },
+      {
+        identity,
+        requestedQuantity,
+        closeableQuantity: 5,
+        closePricePerUnit: 1.20,
+        requestedClosePriceEffect: 'Debit',
+        actualOrderLegs: actualLegs,
+      },
+      async (safetyCheck) => {
+        // The broker function receives the safety-checked plan -- assert its
+        // leg payload is scaled to exactly 1 contract per leg, not 5.
+        expect(safetyCheck.plan?.requestedQuantity).toBe(1);
+        expect(safetyCheck.plan?.legPayload.every(l => l.quantity === 1)).toBe(true);
+        return brokerMock(safetyCheck);
+      }
+    );
+
+    expect(result.submitted).toBe(true);
+    expect(brokerMock).toHaveBeenCalledTimes(1);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// 4. Quote evidence: missing / invalid / crossed always block; stale requires
+//    explicit confirmation
+// ---------------------------------------------------------------------------
+
+describe('submitCloseOrderIfSafe -- quote evidence', () => {
+  const baseGate = (identity: CanonicalCloseIdentity): SafetyGateInput => ({
+    identity,
+    requestedQuantity: identity.quantity,
+    closeableQuantity: identity.quantity,
+    closePricePerUnit: 1.20,
+    requestedClosePriceEffect: 'Debit',
+  });
+
+  it('does not call the broker when the quote is explicitly missing (null)', async () => {
+    const identity = buildValidCreditIdentity();
+    const brokerMock = vi.fn();
+    const result = await submitCloseOrderIfSafe(
+      { identity, structureAmbiguous: false, structureBlockMessage: null },
+      { ...baseGate(identity), quote: null },
+      brokerMock
+    );
+    expect(result.submitted).toBe(false);
+    expect(brokerMock).not.toHaveBeenCalled();
+  });
+
+  it('does not call the broker when the quote is one-sided or invalid (non-finite / negative)', async () => {
+    const identity = buildValidCreditIdentity();
+    for (const quote of [
+      { netBid: null, netAsk: 1.25, netMid: null, fetchedAtMs: Date.now() },
+      { netBid: -1, netAsk: 1.25, netMid: 0.1, fetchedAtMs: Date.now() },
+      { netBid: Number.NaN, netAsk: 1.25, netMid: null, fetchedAtMs: Date.now() },
+    ]) {
+      const brokerMock = vi.fn();
+      const result = await submitCloseOrderIfSafe(
+        { identity, structureAmbiguous: false, structureBlockMessage: null },
+        { ...baseGate(identity), quote },
+        brokerMock
+      );
+      expect(result.submitted).toBe(false);
+      expect(brokerMock).not.toHaveBeenCalled();
+    }
+  });
+
+  it('does not call the broker when the quote is crossed (bid > ask)', async () => {
+    const identity = buildValidCreditIdentity();
+    const brokerMock = vi.fn();
+    const result = await submitCloseOrderIfSafe(
+      { identity, structureAmbiguous: false, structureBlockMessage: null },
+      { ...baseGate(identity), quote: { netBid: 1.30, netAsk: 1.20, netMid: 1.25, fetchedAtMs: Date.now() } },
+      brokerMock
+    );
+    expect(result.submitted).toBe(false);
+    expect(brokerMock).not.toHaveBeenCalled();
+  });
+
+  it('does not call the broker for a stale quote without explicit confirmation, but DOES call it once staleQuoteConfirmed is true', async () => {
+    const identity = buildValidCreditIdentity();
+    const staleQuote = { netBid: 1.15, netAsk: 1.25, netMid: 1.20, fetchedAtMs: Date.now() - 10 * 60 * 1000 };
+
+    const blockedBroker = vi.fn();
+    const blockedResult = await submitCloseOrderIfSafe(
+      { identity, structureAmbiguous: false, structureBlockMessage: null },
+      { ...baseGate(identity), quote: staleQuote },

+// ---------------------------------------------------------------------------
+// 7. Roll closing legs remain distinct from opening-leg economics
+// ---------------------------------------------------------------------------
+
+describe('submitCloseOrderIfSafe -- roll closing-leg isolation', () => {
+  it('the plan built for the CLOSING side of a roll contains only the original position\'s legs, never any new opening legs', async () => {
+    // A roll is modeled here as: close the existing 2-contract BPS at its own
+    // canonical identity, entirely independent of whatever new spread will be
+    // opened afterward. The orchestration boundary has no concept of "roll" --
+    // it only ever sees the CLOSING identity, which is the exact isolation
+    // property required: the plan cannot accidentally absorb new-leg economics
+    // it was never given.
+    const closingIdentity = buildValidCreditIdentity(2);
+    const brokerMock = vi.fn().mockResolvedValue({ data: { order: { id: 'OK-ROLL-CLOSE' } } });
+    const actualLegs = legsToActualOrderLegs(closingIdentity, closingIdentity.quantity);
+
+    const result = await submitCloseOrderIfSafe(
+      { identity: closingIdentity, structureAmbiguous: false, structureBlockMessage: null },
+      {
+        identity: closingIdentity,
+        requestedQuantity: closingIdentity.quantity,
+        closeableQuantity: closingIdentity.quantity,
+        closePricePerUnit: 1.20,
+        requestedClosePriceEffect: 'Debit',
+        actualOrderLegs: actualLegs,
+      },
+      brokerMock
+    );
+
+    expect(result.submitted).toBe(true);
+    const plan = result.submitted ? result.safetyCheck.plan! : null;
+    expect(plan?.legPayload).toHaveLength(closingIdentity.legs.length);
+    expect(plan?.legPayload.map(l => l.symbol).sort()).toEqual(closingIdentity.legs.map(l => l.symbol).sort());
+  });
+});
